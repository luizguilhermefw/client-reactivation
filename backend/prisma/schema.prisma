generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum MediaAssetStatus {
  PENDING
  READY
  DELETE_PENDING
  DELETED
  FAILED
}

model Company {
  id          String @id @default(uuid())
  name        String
  displayName String
  cnpj        String @unique

  status CompanyStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  users            User[]
  customers        Customer[]
  automations      Automation[]
  outboundMessages OutboundMessage[]
  messageLogs      MessageLog[]
  mediaAssets      MediaAsset[]

  @@index([name])
}

model MediaAsset {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  storageProvider String
  bucket          String
  /// Internal object path only. Never persist a public URL or download token.
  objectKey       String

  originalName   String
  mimeType       String
  sizeBytes      Int
  /// SHA-256 hexadecimal digest stored at its exact 64-character length.
  checksumSha256 String @db.Char(64)

  status MediaAssetStatus @default(PENDING)

  expiresAt        DateTime?
  storageDeletedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  outboundMessages OutboundMessage[]

  @@unique([id, companyId])
  @@unique([companyId, checksumSha256])
  @@unique([storageProvider, bucket, objectKey])
  @@index([companyId, status])
  @@index([status, expiresAt])
}

enum UserRole {
  PLATFORM_ADMIN
  SUPPORT

  OWNER
  MANAGER
  OPERATOR
  VIEWER
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  createdAt DateTime @default(now())

  role UserRole @default(OWNER)
}

model Customer {
  id                    String            @id @default(uuid())
  name                  String
  phone                 String
  lastPurchaseDate      DateTime
  birthDate             DateTime?
  isActiveForAutomation Boolean           @default(true)
  company               Company           @relation(fields: [companyId], references: [id])
  companyId             String
  logs                  MessageLog[]
  outboundMessages      OutboundMessage[]
  createdAt             DateTime          @default(now())

  @@unique([id, companyId])
  @@index([companyId])
  @@index([phone])
}

model Automation {
  id   String         @id @default(uuid())
  name String
  type AutomationType @default(REACTIVATION)

  daysAfter Int?
  message   String?
  isActive  Boolean @default(false)

  cooldownHours Int @default(24)

  isSystem  Boolean @default(false)
  systemKey String?

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  logs             MessageLog[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  outboundMessages OutboundMessage[]

  @@unique([companyId, name])
  @@unique([companyId, systemKey])
  @@unique([id, companyId])
  @@index([companyId])
  @@index([companyId, isSystem])
}

model MessageLog {
  id String @id @default(uuid())

  companyId         String
  customerId        String?
  automationId      String?
  outboundMessageId String? @unique

  status LogStatus

  scheduledDate DateTime
  sentAt        DateTime?

  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  automation      Automation?      @relation(fields: [automationId, companyId], references: [id, companyId], onDelete: Restrict)
  outboundMessage OutboundMessage? @relation(fields: [outboundMessageId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([outboundMessageId, companyId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, scheduledDate])
  @@index([companyId, status, scheduledDate])
  @@index([companyId, customerId, automationId])
}

enum AutomationType {
  REACTIVATION
  BIRTHDAY
  CAMPAIGN
  MAINTENANCE
}

enum LogStatus {
  PENDING
  SENT
  FAILED
}

enum OutboundMessageStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum OutboundMessageSource {
  AUTOMATION
  CAMPAIGN
  MANUAL
}

enum OutboundMessageType {
  TEXT
  IMAGE
}

model OutboundMessage {
  id String @id @default(uuid())

  companyId    String
  customerId   String?
  automationId String?
  mediaAssetId String?

  source OutboundMessageSource
  type   OutboundMessageType   @default(TEXT)
  status OutboundMessageStatus @default(PENDING)

  recipientPhone String
  content        String @db.Text
  payload        Json?

  scheduledAt DateTime @default(now())
  availableAt DateTime @default(now())

  processingAt DateTime?
  sentAt       DateTime?
  failedAt     DateTime?

  attempts    Int @default(0)
  maxAttempts Int @default(3)
  priority    Int @default(0)

  lockedAt DateTime?
  lockedBy String?

  provider          String?
  providerMessageId String?

  lastError     String? @db.Text
  lastErrorCode String?

  idempotencyKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId, companyId], references: [id, companyId], onDelete: Restrict)
  messageLog MessageLog?

  @@unique([id, companyId])
  @@unique([companyId, idempotencyKey])
  @@index([status, availableAt, priority])
  @@index([status, lockedAt])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, automationId])
  @@index([companyId, mediaAssetId])
}
