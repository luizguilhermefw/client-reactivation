# Public access is bound to 127.0.0.1 by docker-compose.yml.
EVOLUTION_PORT=8080
# Valid only for local execution or access through an SSH tunnel.
# With a VPS reverse proxy, use a public HTTPS URL such as:
# SERVER_URL=https://evolution-dev.example.com
SERVER_URL=http://localhost:8080

# Generate a different strong value for local use. Never commit the real key.
AUTHENTICATION_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_API_KEY
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# Keep POSTGRES_PASSWORD and the password embedded in DATABASE_CONNECTION_URI identical.
# Use a URL-safe password or percent-encode reserved URI characters.
POSTGRES_USER=evolution_dev
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_URL_SAFE_PASSWORD
POSTGRES_DB=evolution_dev
DATABASE_CONNECTION_URI=postgresql://evolution_dev:CHANGE_ME_GENERATE_A_URL_SAFE_PASSWORD@postgres:5432/evolution_dev?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=aylaflow_evolution_dev
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=true

# Redis is reachable only inside the private Compose network.
REDIS_URI=redis://redis:6379/0
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=aylaflow_evolution_dev
CACHE_REDIS_SAVE_INSTANCES=false

# Baileys and local runtime settings supported by Evolution API v2.3.7.
CONFIG_SESSION_PHONE_CLIENT=Evolution API Dev
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
LANGUAGE=en
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error
TELEMETRY_ENABLED=false
DEL_INSTANCE=false

# Optional integrations remain disabled in this isolated development stack.
WEBSOCKET_ENABLED=false
WEBHOOK_GLOBAL_ENABLED=false
RABBITMQ_ENABLED=false
SQS_ENABLED=false
KAFKA_ENABLED=false
TYPEBOT_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false
S3_ENABLED=false
