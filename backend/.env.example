DATABASE_URL=
ZAPI_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=

IMAGE_MEDIA_ALLOWED_HOSTS=firebasestorage.googleapis.com,storage.googleapis.com

FIREBASE_STORAGE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
MEDIA_READ_URL_TTL_SECONDS=900

JWT_SECRET=
JWT_EXPIRES_IN=1d

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_REQUEST_TIMEOUT_MS=10000
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_PUBLIC_URL=

CORS_ORIGINS=http://localhost:5173
PUBLIC_REGISTRATION_BASE_URL=
# Keep false unless requests arrive through a trusted local reverse proxy.
TRUST_PROXY=false

# Customer CPF keys must be distinct, random and canonical base64.
# HMAC keys require at least 32 decoded bytes; AES-256 keys require exactly 32.
CUSTOMER_CPF_ACTIVE_KEY_VERSION=
CUSTOMER_CPF_HMAC_KEY_V1=
CUSTOMER_CPF_ENCRYPTION_KEY_V1=

# Meta webhook: POST requires HMAC of raw body; GET uses a separate verify token.
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
